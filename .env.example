# Environment variables consumed by the Supabase Edge Functions (supabase/functions/*).
# For local dev, copy to `supabase/.env` and run `supabase functions serve --env-file supabase/.env`.
# In production these are provided automatically by the Supabase platform
# (SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY) — set them as function secrets.

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Service-role key — used by Edge Functions to read/write with RLS bypassed.
# NEVER expose this to the browser. Lovable talks to Supabase with the anon key;
# only these server-side functions use the service role.
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket where generated PDF reports are uploaded (default: reports).
REPORT_BUCKET=reports
# Signed-URL lifetime for a generated report download link, in seconds.
REPORT_LINK_TTL_SECONDS=3600
