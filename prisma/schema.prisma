generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  googleId  String?  @unique
  role      String   @default("BUYER") // BUYER | OPERATOR
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  accounts Account[]
  sessions Session[]

  requests       PartsRequest[]         @relation("BuyerRequests")
  curations      PartsRequest[]         @relation("CuratorAssignments")
  clarifications ClarificationMessage[]
  auditLogs      AuditLog[]
}

// NextAuth
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PartsRequest {
  id               String   @id @default(cuid())
  buyerId          String
  curatorId        String?
  primaryCategory  String
  subCategory      String
  title            String
  rawDescription   String
  transcript       String?
  audioUrl         String?
  specs            String   @default("{}")
  missingFields    String   @default("[]")
  rejectionReasons String   @default("[]")
  budgetCents      Int
  serviceFeeCents  Int      @default(2500)
  waiverVersion    String?
  waiverAcceptedAt DateTime?
  status           String   @default("DRAFT")
  paymentAuthId    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  buyer    User                   @relation("BuyerRequests", fields: [buyerId], references: [id])
  curator  User?                  @relation("CuratorAssignments", fields: [curatorId], references: [id])
  images   RequestImage[]
  messages ClarificationMessage[]
  matches  Match[]
  order    Order?

  @@index([buyerId])
  @@index([status])
  @@index([curatorId])
  @@index([primaryCategory])
}

model RequestImage {
  id            String   @id @default(cuid())
  requestId     String
  url           String
  visionSummary String?
  createdAt     DateTime @default(now())

  request PartsRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model ClarificationMessage {
  id           String   @id @default(cuid())
  requestId    String
  direction    String // SYSTEM | USER | OPERATOR
  content      String
  answeredById String?
  createdAt    DateTime @default(now())

  request    PartsRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  answeredBy User?        @relation(fields: [answeredById], references: [id])

  @@index([requestId])
}

model Match {
  id                String   @id @default(cuid())
  requestId         String
  sourceMarketplace String
  listingUrl        String
  sellerHandle      String
  sellerLocation    String
  displayLabel      String
  title             String
  priceCents        Int
  shippingCents     Int      @default(0)
  condition         String
  thumbnailUrl      String?
  specHighlights    String   @default("{}")
  proofVideoUrl     String?
  confidence        Float
  status            String   @default("PROPOSED")
  hiddenFromBuyer   Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  request PartsRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  order   Order?

  @@index([requestId])
  @@index([status])
}

model Order {
  id                        String    @id @default(cuid())
  requestId                 String    @unique
  matchId                   String    @unique
  totalCents                Int
  paymentStatus             String    @default("NONE")
  fulfillmentStatus         String    @default("PENDING")
  escrowState               String    @default("HELD")
  buyerVerificationDeadline DateTime?
  sellerPayoutReleaseAt     DateTime?
  trackingNumber            String?
  notes                     String?
  timeline                  String    @default("[]")
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  request PartsRequest @relation(fields: [requestId], references: [id])
  match   Match        @relation(fields: [matchId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  event     String
  requestId String?
  matchId   String?
  orderId   String?
  actorId   String?
  metadata  String   @default("{}")
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([requestId])
}
